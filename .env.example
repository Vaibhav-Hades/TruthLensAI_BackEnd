# ── Server ───────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development

# ── Supabase (database) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. NEVER expose in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if you do not use the service-role key (RLS will then block writes).
SUPABASE_ANON_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required when NODE_ENV=production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI / evidence providers ──────────────────────────────────────────────────
GROQ_API_KEY=            # LLM + Whisper transcription
GROQ_MODEL=openai/gpt-oss-20b   # llama-3.1-8b-instant was retired by Groq (404)
ER_API_KEY=              # Event Registry (news evidence retrieval)

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production frontend origin(s). Local dev origins (localhost:5173/3000) are always allowed.
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=            # optional extra origins, comma-separated
# Vercel preview URLs matching ^https://truth-?lens...vercel.app$ are allowed by default.
# CORS_ALLOW_VERCEL_PREVIEWS=false
# CORS_VERCEL_PATTERN=^https://my-project[a-z0-9-]*\.vercel\.app$

# ── Media tools (video transcription fallback) ───────────────────────────────
# Leave empty on Linux/Docker (they are on PATH). On Windows set full paths if not on PATH.
YTDLP_PATH=
FFMPEG_PATH=
# Optional cookies.txt to get past YouTube bot checks from datacenter IPs (e.g. Render)
YTDLP_COOKIES=

# ── Reference dataset (optional; see README for layout) ──────────────────────
# REFERENCE_DATASET_PATH=./data
# REFERENCE_DATASET_MAX_ROWS=6000

# ── Limits ───────────────────────────────────────────────────────────────────
# MAX_INPUT_CHARS=100000
# MAX_ANALYSIS_CHARS=20000
# ANALYZE_RATE_LIMIT=10
